# Configuration pour uat.upjunoo.com — à copier en `deploy/.env` sur le serveur.
#
# Topologie B : une seule origine, derrière le nginx déjà en place.
# `upjunoo.com` n'ayant pas de DNS joker, les trois composants partagent le nom
# `uat.upjunoo.com` et se distinguent par un préfixe de chemin.

# --- URL publiques ----------------------------------------------------------
#
# Ce sont des URL COMPLÈTES, pas des noms d'hôte : c'est ce qui permet les
# préfixes de chemin. Elles doivent correspondre exactement au vhost nginx.
APP_URL=https://uat.upjunoo.com
API_URL=https://uat.upjunoo.com/backend
SITE_URL=https://uat.upjunoo.com/vitrine

# Le préfixe est passé séparément au build du site : Next en a besoin comme
# `basePath`, sans le schéma ni le domaine.
SITE_BASE_PATH=/vitrine

# --- Non utilisés dans cette topologie --------------------------------------
#
# Réservés au profil `standalone` (Caddy en façade). Laissés vides ici : Caddy
# ne démarre pas, mais `docker compose` réclame que les variables existent.
SITE_DOMAIN=
APP_DOMAIN=
API_DOMAIN=
ACME_EMAIL=

# --- Base de données --------------------------------------------------------
POSTGRES_DB=registre
POSTGRES_USER=registre_owner
POSTGRES_PASSWORD=            # GÉNÉRER
REGISTRE_APP_PASSWORD=        # GÉNÉRER

# --- Secrets ----------------------------------------------------------------
JWT_SECRET=                   # GÉNÉRER
FILE_SIGNING_SECRET=          # GÉNÉRER
SESSION_SECRET=               # GÉNÉRER
CRON_SECRET=                  # GÉNÉRER

# --- Connexion Google (facultatif) ------------------------------------------
# Origine JavaScript autorisée : https://uat.upjunoo.com
# URI de redirection autorisé  : https://uat.upjunoo.com/login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envoi d'e-mails (facultatif) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@upjunoo.com
