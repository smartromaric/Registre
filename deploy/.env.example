# Configuration du déploiement — à copier en `.env` SUR LE SERVEUR.
#
# Ce fichier-ci est un modèle et n'est pas versionné avec des secrets réels :
# `deploy/.env` est ignoré par git (voir .gitignore).
#
# Les valeurs marquées « GÉNÉRER » ne doivent JAMAIS être inventées à la main.
# Le script `bootstrap.sh` les tire de `openssl rand`.

# --- Domaines ---------------------------------------------------------------
#
# sslip.io fournit un nom qui résout vers l'IP indiquée, sans inscription :
# `194-29-101-141.sslip.io` -> 194.29.101.141. Cela suffit à Let's Encrypt, qui
# refuse en revanche de certifier une adresse IP nue — et sans HTTPS le cookie
# de session, posé avec `Secure`, serait rejeté par le navigateur.
#
# Avec un vrai domaine, remplacer simplement ces trois lignes
# (ex. registre.cm / app.registre.cm / api.registre.cm) et relancer.
SITE_DOMAIN=194-29-101-141.sslip.io
APP_DOMAIN=app.194-29-101-141.sslip.io
API_DOMAIN=api.194-29-101-141.sslip.io

# Adresse à laquelle Let's Encrypt prévient d'un certificat proche d'expirer.
ACME_EMAIL=arcoteksdev@gmail.com

# --- Base de données --------------------------------------------------------
POSTGRES_DB=registre
POSTGRES_USER=registre_owner
POSTGRES_PASSWORD=            # GÉNÉRER
# Le rôle applicatif restreint, celui qui tourne en permanence.
REGISTRE_APP_PASSWORD=        # GÉNÉRER

# --- Secrets ----------------------------------------------------------------
JWT_SECRET=                   # GÉNÉRER — invalider = déconnecter tout le monde
FILE_SIGNING_SECRET=          # GÉNÉRER — signe les URL de téléchargement
SESSION_SECRET=               # GÉNÉRER — cookie de session du frontend
CRON_SECRET=                  # GÉNÉRER — garde la route de balayage manuel

# --- Connexion Google (facultatif) ------------------------------------------
#
# Laisser vide tant que les URL de production ne sont pas déclarées dans la
# console Google Cloud : l'écran affiche alors un état « non configuré »
# honnête, et la connexion par mot de passe reste utilisable.
#
# Origines JavaScript autorisées :  https://app.<domaine>
# URI de redirection autorisés   :  https://app.<domaine>/login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envoi d'e-mails (facultatif) -------------------------------------------
#
# Sans SMTP, les invitations et réinitialisations de mot de passe ne partent
# pas. L'application le signale plutôt que de faire croire à un envoi réussi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@registre.app
