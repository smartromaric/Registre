# Adresse de l'application vers laquelle pointent tous les appels a l'action.
# ATTENTION : le site est exporte en statique, cette valeur est figee au moment
# de la construction. La changer impose de reconstruire et redeployer le site.
#
# Developpement : le port du frontend local.
# Production    : l'URL du service registre-web (voir render.yaml).
NEXT_PUBLIC_APP_URL=http://localhost:3001
