# Copier en .env et adapter localement. Ne jamais committer le .env réel.

ENVIRONMENT=development
# Base publique de CE backend (schéma + hôte) — sert à qualifier les liens
# signés du stockage local en URL complète, jamais relative (voir
# app/storage/local.py). À ajuster en production (nom de domaine réel de l'API).
API_PUBLIC_URL=http://localhost:8000

# Connexion applicative (rôle restreint, soumis aux politiques RLS)
DATABASE_URL=postgresql+asyncpg://registre_app:registre_app_dev_pw@localhost:5432/registre
# Connexion utilisée par Alembic pour les migrations (rôle proprietaire des tables)
DATABASE_URL_MIGRATIONS=postgresql+psycopg://postgres:postgres@localhost:5432/registre

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

FILE_SIGNING_SECRET=change-me-file-signing-secret
SIGNED_URL_EXPIRE_SECONDS=300

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=registre
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@registre.app
SMTP_USE_TLS=true

CORS_ORIGINS=["http://localhost:3000"]

TRIAL_PERIOD_DAYS=14
READ_ONLY_GRACE_DAYS=30
RETENTION_MONTHS=12
