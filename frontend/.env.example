# URL de base de l'API backend FastAPI (préfixe /api/v1 déjà inclus côté client).
# En local, le backend tourne avec : cd backend && .venv\Scripts\python.exe -m uvicorn app.main:app --reload
NEXT_PUBLIC_API_URL=http://localhost:8000

# Identifiant client OAuth Google (Google Identity Services), utilisé uniquement
# côté navigateur pour obtenir un id_token que le backend vérifie sur POST /api/v1/auth/google.
# Sans cette valeur, le bouton "Continuer avec Google" reste visible mais affiche un état
# "non configuré" honnête au lieu de simuler une connexion (voir frontend/README.md).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Secret utilisé pour signer/chiffrer le cookie httpOnly qui porte le refresh token
# (voir src/lib/session.ts). Générez une valeur avec : openssl rand -base64 32
SESSION_SECRET=change-me-in-development
